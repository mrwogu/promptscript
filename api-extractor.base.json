{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/api/",
    "reportTempFolder": "<projectFolder>/../../tmp/api-report/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "newlineKind": "lf",
  "messages": {
    "compilerMessageReporting": { "default": { "logLevel": "warning" } },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning", "addToApiReportFile": true },
      "ae-forgotten-export": { "logLevel": "none", "addToApiReportFile": true },
      "ae-incompatible-release-tags": { "logLevel": "none", "addToApiReportFile": true },
      "ae-missing-release-tag": { "logLevel": "none", "addToApiReportFile": false },
      "ae-internal-missing-underscore": { "logLevel": "none", "addToApiReportFile": false }
    },
    "tsdocMessageReporting": { "default": { "logLevel": "none" } }
  }
}
