{
  "name": "@promptscript/source",
  "version": "1.25.0",
  "license": "MIT",
  "homepage": "https://getpromptscript.dev/",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "typecheck": "pnpm nx run-many -t typecheck",
    "schema:generate": "ts-node --esm scripts/generate-schema.mts",
    "schema:check": "./scripts/check-schema.sh",
    "docs:serve": "nx serve docs",
    "docs:build": "nx build docs",
    "docs:generate": "typedoc && node --import @swc-node/register/esm-register scripts/add-api-frontmatter.mts",
    "docs:generate:check": "typedoc && node --import @swc-node/register/esm-register scripts/add-api-frontmatter.mts && node --import @swc-node/register/esm-register scripts/add-api-frontmatter.mts --check",
    "playground:serve": "nx serve playground",
    "playground:links": "node --import @swc-node/register/esm-register scripts/add-playground-links.mts",
    "docs:validate": "node --import @swc-node/register/esm-register scripts/validate-docs-examples.mts",
    "docs:validate:check": "node --import @swc-node/register/esm-register scripts/validate-docs-examples.mts --check",
    "docs:formatters": "node --import @swc-node/register/esm-register scripts/generate-formatter-docs.mts && npx prettier --write docs/reference/formatters/*.md",
    "docs:formatters:check": "node --import @swc-node/register/esm-register scripts/generate-formatter-docs.mts && npx prettier --write docs/reference/formatters/*.md && git diff --exit-code docs/reference/formatters/ && test -z \"$(git status --porcelain docs/reference/formatters/)\"",
    "docs:models": "node --import @swc-node/register/esm-register scripts/generate-model-docs.mts && npx prettier --write docs/reference/models.md",
    "docs:models:check": "node --import @swc-node/register/esm-register scripts/generate-model-docs.mts && npx prettier --write docs/reference/models.md && git diff --exit-code docs/reference/models.md",
    "models:drift": "node --import @swc-node/register/esm-register scripts/model-drift.mts --check",
    "models:drift:apply": "node --import @swc-node/register/esm-register scripts/model-drift.mts --apply",
    "prs": "node --import @swc-node/register/esm-register packages/cli/src/cli.ts",
    "skill:sync": "./scripts/sync-skill.sh",
    "skill:check": "./scripts/sync-skill.sh --check",
    "package:check": "node --import @swc-node/register/esm-register scripts/package-check.mts",
    "api:check": "node --import @swc-node/register/esm-register scripts/api-report.mts",
    "api:update": "node --import @swc-node/register/esm-register scripts/api-report.mts --update",
    "api:breaking": "node --import @swc-node/register/esm-register scripts/api-breaking.mts",
    "grammar:check": "node --import @swc-node/register/esm-register scripts/check-grammar.mts",
    "deno:check": "node --import @swc-node/register/esm-register scripts/check-deno-bundle.mts",
    "deno:suite": "node --import @swc-node/register/esm-register scripts/test-deno-cli.mts",
    "docs:highlight:check": "node --import @swc-node/register/esm-register scripts/check-docs-highlighting.mts",
    "vscode:package": "nx package vscode",
    "vscode:publish": "nx publish vscode",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "7.60.1",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vite": "24.0.3",
    "@nx/vitest": "23.2.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.2",
    "@swc/core": "~1.16.20",
    "@swc/helpers": "~0.5.23",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lz-string": "^1.5.0",
    "nx": "23.2.1",
    "path-browserify": "^1.0.1",
    "prettier": "~3.9.10",
    "publint": "0.3.25",
    "shiki": "^4.5.0",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~6.0.3",
    "verdaccio": "^6.11.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "nx": {
    "includedScripts": []
  }
}
