{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://getpromptscript.dev/schema/eval-suite/v1.json",
  "title": "PromptScript Eval Suite v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://getpromptscript.dev/schema/eval-suite/v1.json",
      "description": "Schema URL, the version tag of the suite.",
      "examples": [
        "https://getpromptscript.dev/schema/eval-suite/v1.json"
      ]
    },
    "prompt": {
      "type": "string",
      "description": "Prompt id under test.",
      "examples": [
        "acme-support/refund-reply"
      ]
    },
    "dataset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/EvalDatasetRef"
        }
      ],
      "description": "Dataset file relative to the suite file, or a reference with review decisions"
    },
    "labels": {
      "type": "string",
      "description": "Human label file, relative to the suite file.",
      "examples": [
        "labels/refund-reply.jsonl"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/definitions/EvalModelEntry"
          }
        ]
      },
      "description": "Models to run the whole dataset on; absent means the prompt's own model.",
      "minItems": 1,
      "maxItems": 8
    },
    "judge": {
      "$ref": "#/definitions/EvalJudgeConfig",
      "description": "Judge settings shared by the llm-judge assertions"
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvalAssertion"
      },
      "description": "Assertions every case must pass.",
      "minItems": 1,
      "maxItems": 20
    },
    "thresholds": {
      "$ref": "#/definitions/EvalThresholds",
      "description": "Limits the run must meet"
    }
  },
  "required": [
    "prompt",
    "dataset",
    "assertions"
  ],
  "additionalProperties": false,
  "description": "An eval suite file, version 1.",
  "definitions": {
    "EvalDatasetRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Dataset file, relative to the suite file.",
          "examples": [
            "datasets/refund-reply.jsonl"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvalDatasetAllow"
          },
          "description": "Scan rules whose findings are expected in this dataset"
        },
        "allowPii": {
          "$ref": "#/definitions/EvalDatasetAllowPii",
          "description": "Personal data is expected in this dataset"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "description": "Dataset reference of a suite with review decisions."
    },
    "EvalDatasetAllow": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "description": "Validator rule id whose findings are expected in the dataset.",
          "examples": [
            "PS005"
          ],
          "pattern": "^PS\\d{3,4}$"
        },
        "reason": {
          "type": "string",
          "description": "Why the content is expected; copied into the report"
        }
      },
      "required": [
        "rule",
        "reason"
      ],
      "additionalProperties": false,
      "description": "A dataset scan rule the suite owner expects to fire, with the reason."
    },
    "EvalDatasetAllowPii": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "Why personal data is expected; copied into the report"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "description": "Decision that the dataset may hold personal data, with the reason."
    },
    "EvalModelEntry": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "description": "Model reference: profile id, alias or API id.",
          "examples": [
            "gpt-5.1"
          ]
        },
        "params": {
          "$ref": "#/definitions/ModelParams",
          "description": "Parameters that override the prompt's parameters for this entry only"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "description": "One model a suite runs, with parameters merged over the prompt's own."
    },
    "ModelParams": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "Sampling temperature"
        },
        "topP": {
          "type": "number",
          "description": "Nucleus sampling threshold"
        },
        "topK": {
          "type": "integer",
          "description": "Top-k sampling cutoff.",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "description": "Maximum number of tokens to generate.",
          "minimum": 1
        },
        "stop": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stop sequences, in authored order"
        },
        "seed": {
          "type": "integer",
          "description": "Sampling seed, at most 2^53-1.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "Invocation parameters of a model."
    },
    "EvalJudgeConfig": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "Model reference the judge runs on"
        },
        "runs": {
          "$ref": "#/definitions/EvalJudgeRuns",
          "description": "Judge runs per case; default 3"
        }
      },
      "additionalProperties": false,
      "description": "Judge settings shared by the suite's llm-judge assertions."
    },
    "EvalJudgeRuns": {
      "type": "number",
      "enum": [
        1,
        3,
        5
      ],
      "description": "Number of judge runs per case; the majority verdict counts."
    },
    "EvalAssertion": {
      "anyOf": [
        {
          "$ref": "#/definitions/EvalEqualsAssertion"
        },
        {
          "$ref": "#/definitions/EvalContainsAssertion"
        },
        {
          "$ref": "#/definitions/EvalRegexAssertion"
        },
        {
          "$ref": "#/definitions/EvalJsonSchemaAssertion"
        },
        {
          "$ref": "#/definitions/EvalLlmJudgeAssertion"
        }
      ],
      "description": "One assertion of a suite, by kind."
    },
    "EvalEqualsAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Assertion id, unique in the suite.",
          "examples": [
            "decision-matches"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "field": {
          "type": "string",
          "description": "Output property the assertion reads; absent means the whole response text"
        },
        "kind": {
          "type": "string",
          "const": "equals"
        },
        "negate": {
          "type": "boolean",
          "description": "Inverts the result"
        },
        "value": {
          "type": "string",
          "description": "Value to compare with; absent means the row's expected value"
        },
        "ignoreCase": {
          "type": "boolean",
          "description": "Compare case-insensitively"
        },
        "trim": {
          "type": "boolean",
          "description": "Trim both sides before comparing; default true"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "description": "Passes when the target equals `value`, else the row's expected value."
    },
    "EvalContainsAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Assertion id, unique in the suite.",
          "examples": [
            "decision-matches"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "field": {
          "type": "string",
          "description": "Output property the assertion reads; absent means the whole response text"
        },
        "kind": {
          "type": "string",
          "const": "contains"
        },
        "negate": {
          "type": "boolean",
          "description": "Inverts the result"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Substrings to look for.",
          "minItems": 1,
          "maxItems": 20
        },
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "description": "Whether every value or any value must appear; default all"
        },
        "ignoreCase": {
          "type": "boolean",
          "description": "Compare case-insensitively"
        }
      },
      "required": [
        "id",
        "kind",
        "values"
      ],
      "additionalProperties": false,
      "description": "Passes when the target contains the values."
    },
    "EvalRegexAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Assertion id, unique in the suite.",
          "examples": [
            "decision-matches"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "field": {
          "type": "string",
          "description": "Output property the assertion reads; absent means the whole response text"
        },
        "kind": {
          "type": "string",
          "const": "regex"
        },
        "negate": {
          "type": "boolean",
          "description": "Inverts the result"
        },
        "pattern": {
          "type": "string",
          "description": "Regular expression source.",
          "examples": [
            "\\bguarantee(d)?\\b"
          ]
        },
        "flags": {
          "type": "string",
          "description": "Regular expression flags, any of `i`, `m`, `s` and `u`, each at most once.",
          "pattern": "^(?!.*(.).*\\1)[imsu]{0,4}$"
        }
      },
      "required": [
        "id",
        "kind",
        "pattern"
      ],
      "additionalProperties": false,
      "description": "Passes when the pattern matches the target."
    },
    "EvalJsonSchemaAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Assertion id, unique in the suite.",
          "examples": [
            "decision-matches"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "field": {
          "type": "string",
          "description": "Output property the assertion reads; absent means the whole response text"
        },
        "kind": {
          "type": "string",
          "const": "json-schema"
        },
        "schema": {
          "type": "object",
          "additionalProperties": {},
          "description": "Inline JSON Schema; absent means the prompt's output contract"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "description": "Passes when the parsed response matches a JSON Schema."
    },
    "EvalLlmJudgeAssertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Assertion id, unique in the suite.",
          "examples": [
            "decision-matches"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "field": {
          "type": "string",
          "description": "Output property the assertion reads; absent means the whole response text"
        },
        "kind": {
          "type": "string",
          "const": "llm-judge"
        },
        "rubric": {
          "type": "string",
          "description": "Prompt id of the rubric.",
          "examples": [
            "acme-support/judge-polite-reply"
          ]
        },
        "criteria": {
          "type": "string",
          "description": "Extra criteria passed to the rubric as its `criteria` input"
        },
        "model": {
          "type": "string",
          "description": "Model reference the judge runs on; absent means the suite judge, then the rubric's own model"
        },
        "runs": {
          "$ref": "#/definitions/EvalJudgeRuns",
          "description": "Judge runs per case; absent means the suite judge setting"
        }
      },
      "required": [
        "id",
        "kind",
        "rubric"
      ],
      "additionalProperties": false,
      "description": "Passes when the majority of judge runs say pass. The rubric receives the inputs `response`, `case_inputs`, `expected`, `criteria` and the reserved `boundary`."
    },
    "EvalThresholds": {
      "type": "object",
      "properties": {
        "passRate": {
          "type": "number",
          "description": "Minimum share of passed cases per model entry, 0 to 1; default 1.",
          "minimum": 0,
          "maximum": 1
        },
        "maxCostUsd": {
          "type": "number",
          "description": "Cost limit of the whole suite run in USD.",
          "minimum": 0
        },
        "maxCostPerCaseUsd": {
          "type": "number",
          "description": "Cost limit of one case in USD.",
          "minimum": 0
        },
        "latencyMs": {
          "$ref": "#/definitions/EvalLatencyThresholds",
          "description": "Latency limits"
        }
      },
      "additionalProperties": false,
      "description": "Limits a run must meet for the suite to pass."
    },
    "EvalLatencyThresholds": {
      "type": "object",
      "properties": {
        "p50": {
          "type": "integer",
          "description": "Median latency limit in milliseconds.",
          "minimum": 1
        },
        "p95": {
          "type": "integer",
          "description": "95th percentile latency limit in milliseconds.",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "Latency limits over the recorded latencies of a run."
    }
  }
}
