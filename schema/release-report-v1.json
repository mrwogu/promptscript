{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://getpromptscript.dev/schema/release-report/v1.json",
  "title": "PromptScript Release Report",
  "description": "Machine-readable report emitted by prs release <command> --format json.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "command",
    "success",
    "dryRun",
    "changes",
    "environments",
    "warnings",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://getpromptscript.dev/schema/release-report/v1.json"
    },
    "version": {
      "const": 1
    },
    "command": {
      "type": "string",
      "enum": ["build", "promote", "rollback", "split", "status"],
      "description": "Open enum: new values can be added in this version, so handle unknown values."
    },
    "success": {
      "type": "boolean",
      "description": "False when the command failed or a release file does not verify."
    },
    "dryRun": {
      "type": "boolean",
      "description": "True when the command wrote nothing."
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Change"
      },
      "description": "Files and label entries the command wrote, or would write under --dry-run. For status --base, the label entries that differ from the base."
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Environment"
      },
      "description": "Filled by status; empty for the other commands."
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EnvironmentHistory"
      },
      "description": "Present when status runs with --history."
    },
    "base": {
      "$ref": "#/definitions/Base",
      "description": "Present when status runs with --base: the ref and the commit it named."
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GateResult"
      },
      "description": "The release gates of every prompt version a prompt policy exists for. Absent without prompt policies."
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModelStatus"
      },
      "description": "Present when status runs with --check-models."
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Diagnostic"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Diagnostic"
      }
    }
  },
  "definitions": {
    "GateResult": {
      "type": "object",
      "required": ["prompt", "contentHash", "environment", "policyRisk", "passed", "checks"],
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/definitions/ContentHash"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "policyRisk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "The highest of the bundle's and the source's risk and risk floors. Closed enum: a new value needs a new schema version."
        },
        "passed": {
          "type": "boolean",
          "description": "False when a check of severity error failed or is unavailable."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GateCheck"
          }
        }
      }
    },
    "GateCheck": {
      "type": "object",
      "required": ["policy", "kind", "severity", "status"],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "layer-boundary",
            "property-protection",
            "registry-allowlist",
            "required-metadata",
            "risk-floor",
            "model-allowlist",
            "required-approvals",
            "required-evals",
            "content-rules",
            "max-experiment-weight"
          ],
          "description": "Open enum: new values can be added in this version, so handle unknown values."
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"],
          "description": "Closed enum: a new value needs a new schema version."
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "unavailable"],
          "description": "unavailable never passes at severity error. Closed enum: a new value needs a new schema version."
        },
        "message": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GateApprovals"
          }
        }
      }
    },
    "GateApprovals": {
      "type": "object",
      "required": ["role", "required", "found", "stale"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "integer",
          "minimum": 1
        },
        "found": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Approvers whose committed record counts for this hash and environment."
        },
        "stale": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Records of this prompt and role for another hash, as <approver> for <short hash>."
        },
        "capped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Records of this hash and role whose maxWeight is below the arm weight, or any capped record for an item that is not an arm, as <approver> up to <percent> %."
        }
      }
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "Change": {
      "type": "object",
      "required": ["path", "action"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path of the file."
        },
        "action": {
          "type": "string",
          "enum": ["created", "updated", "unchanged", "removed"],
          "description": "Closed enum: a new value needs a new schema version."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Prompt id of a bundle or label entry."
        },
        "contentHash": {
          "$ref": "#/definitions/ContentHash",
          "description": "Hash the entry holds after the command."
        },
        "previousContentHash": {
          "$ref": "#/definitions/ContentHash",
          "description": "Hash the entry held before the command."
        },
        "experiment": {
          "$ref": "#/definitions/ChangeExperiment",
          "description": "Present on an arm item of a split, rollback or status --base: the experiment arm the item describes."
        }
      }
    },
    "ChangeExperiment": {
      "type": "object",
      "required": ["name", "variant"],
      "additionalProperties": false,
      "description": "A removed control arm means the experiment ended, not the entry.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Arm name, control for the first arm."
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Share in basis points after the command. Absent for a removed arm."
        },
        "previousWeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Share in basis points before the command. Absent for a new arm."
        }
      }
    },
    "Environment": {
      "type": "object",
      "required": ["name", "path", "exists", "prompts"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path of the label."
        },
        "exists": {
          "type": "boolean",
          "description": "Whether the label file exists."
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PromptStatus"
          }
        }
      }
    },
    "PromptStatus": {
      "type": "object",
      "required": ["id", "contentHash", "file", "exists", "verified", "inBuild"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/definitions/ContentHash"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path of the bundle file."
        },
        "exists": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the bundle file recomputes to its hash."
        },
        "inBuild": {
          "type": "boolean",
          "description": "Whether the latest build manifest holds this hash for the id."
        },
        "experiment": {
          "$ref": "#/definitions/ExperimentStatus",
          "description": "Present while the entry runs an experiment."
        }
      }
    },
    "ExperimentStatus": {
      "type": "object",
      "required": ["name", "arms"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/ArmStatus"
          },
          "description": "The control arm first, in label order."
        }
      }
    },
    "ArmStatus": {
      "type": "object",
      "required": ["variant", "contentHash", "weight", "file", "exists", "verified"],
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "contentHash": {
          "$ref": "#/definitions/ContentHash"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Share in basis points."
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path of the bundle file."
        },
        "exists": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the bundle file recomputes to its hash."
        }
      }
    },
    "EnvironmentHistory": {
      "type": "object",
      "required": ["environment", "commits"],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Commit"
          }
        }
      }
    },
    "Commit": {
      "type": "object",
      "required": ["commit", "date", "subject"],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "date": {
          "type": "string",
          "description": "Author date, ISO 8601."
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "Base": {
      "type": "object",
      "required": ["ref", "commit"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "ModelStatus": {
      "type": "object",
      "required": [
        "environment",
        "prompt",
        "contentHash",
        "ref",
        "provider",
        "apiId",
        "status",
        "retiring"
      ],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/definitions/ContentHash"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Arm name, for an experiment arm other than control."
        },
        "ref": {
          "type": "string",
          "description": "The model as the bundle carries it."
        },
        "profile": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "apiId": {
          "type": "string"
        },
        "status": {
          "enum": ["current", "legacy", "deprecated", "retired", "unknown"],
          "description": "Catalog status of the profile that runs the model, unknown when the catalog has none. Open enum: new values can be added in this version, so handle unknown values."
        },
        "retirementDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Retirement date from the catalog."
        },
        "retiring": {
          "type": "boolean",
          "description": "True when PS5011 reports it: retired, or deprecated with a date within the window."
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
