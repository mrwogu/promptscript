{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://getpromptscript.dev/schema/validate-report/v1.json",
  "title": "PromptScript Validate Report v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://getpromptscript.dev/schema/validate-report/v1.json",
      "description": "Schema URL, the version tag of the report"
    },
    "version": {
      "type": "number",
      "const": 1,
      "description": "Major version of the report format, always 1"
    },
    "success": {
      "type": "boolean",
      "description": "False when there are errors, or warnings under `--strict`"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ValidateErrorV1"
      },
      "description": "Errors of all validated files, in file order"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ValidateWarningV1"
      },
      "description": "Warnings of all validated files, in file order"
    },
    "summary": {
      "$ref": "#/definitions/ValidateSummaryV1",
      "description": "Counts of errors and warnings"
    }
  },
  "required": [
    "$schema",
    "version",
    "success",
    "errors",
    "warnings",
    "summary"
  ],
  "additionalProperties": false,
  "description": "Report of `prs validate --format json`, version 1.",
  "definitions": {
    "ValidateErrorV1": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code, such as `PS2000`. Absent when the run stops before the compile with an error that has no PS code, for example a missing entry file or a registry clone failure.",
          "pattern": "^PS[0-9]{3,4}$"
        },
        "message": {
          "type": "string",
          "description": "Error message"
        },
        "location": {
          "$ref": "#/definitions/ValidateLocationV1",
          "description": "Where the error is, when the compiler knows"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "description": "One error of `prs validate`."
    },
    "ValidateLocationV1": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path of the file"
        },
        "line": {
          "type": "integer",
          "description": "Line number. Some parse errors have no position and report -1.",
          "minimum": -1
        },
        "column": {
          "type": "integer",
          "description": "Column number. Some parse errors have no position and report -1.",
          "minimum": -1
        },
        "offset": {
          "type": "integer",
          "description": "Offset from the start of the file, set on some warnings.",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Where a diagnostic points. The file path is as the compiler reports it, usually absolute."
    },
    "ValidateWarningV1": {
      "type": "object",
      "properties": {
        "ruleId": {
          "type": "string",
          "description": "Validator rule id",
          "examples": [
            "PS008"
          ]
        },
        "message": {
          "type": "string",
          "description": "Warning message"
        },
        "suggestion": {
          "type": "string",
          "description": "Suggested fix"
        },
        "location": {
          "$ref": "#/definitions/ValidateLocationV1",
          "description": "Where the warning is"
        }
      },
      "required": [
        "ruleId",
        "message"
      ],
      "additionalProperties": false,
      "description": "One warning of `prs validate`. With `--strict` a warning fails the run."
    },
    "ValidateSummaryV1": {
      "type": "object",
      "properties": {
        "errorCount": {
          "type": "integer",
          "description": "Number of errors",
          "minimum": 0
        },
        "warningCount": {
          "type": "integer",
          "description": "Number of warnings",
          "minimum": 0
        }
      },
      "required": [
        "errorCount",
        "warningCount"
      ],
      "additionalProperties": false,
      "description": "Counts of errors and warnings in a validate report."
    }
  }
}
