# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data

# MkDocs
/site

# Generated TypeDoc API reference (regenerated by pnpm docs:generate)
/docs/api-reference
# Docs with custom HTML that Prettier breaks
docs/getting-started.md

# Test golden files - must match exact formatter output
**/__golden__/**
**/__snapshots__/**

# API reports - written by api-extractor, compared by pnpm api:check
packages/*/api/*.api.md

# PromptScript generated files - managed by prs compile
CHANGELOG.md

# Compiler-owned JSON that carries no generation marker. Reformatting it makes
# the next `prs compile` treat the file as user-authored and refuse to overwrite.
/.mcp.json
/.vscode/mcp.json
/.factory/mcp.json
/.factory/plugins.json

# Release files written by `prs release`, and the output the runtime example prints.
# CI compares both byte for byte with what the CLI and the example write.
/examples/runtime-node/.promptscript/releases
/examples/runtime-node/expected-output.json
/examples/runtime-node/.promptscript/eval-cache
/examples/runtime-node/.promptscript/eval-baselines
/packages/cli/src/__tests__/__fixtures__/application-prompts/support-refund-reply/.promptscript/eval-cache
/packages/cli/src/__tests__/__fixtures__/application-prompts/support-refund-reply/reports

# Vendored third-party skill assets (HTML copied verbatim from upstream)
**/skills/skill-creator/**/*.html

