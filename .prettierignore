# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data

# MkDocs
/site
# Docs with custom HTML that Prettier breaks
docs/getting-started.md

# Test golden files - must match exact formatter output
**/__golden__/**
**/__snapshots__/**

# PromptScript generated files - managed by prs compile
CHANGELOG.md

# Compiler-owned JSON that carries no generation marker. Reformatting it makes
# the next `prs compile` treat the file as user-authored and refuse to overwrite.
/.mcp.json
/.vscode/mcp.json
/.factory/mcp.json
/.factory/plugins.json

# Vendored third-party skill assets (HTML copied verbatim from upstream)
**/skills/skill-creator/**/*.html

# schema
schema/config.json

# Lock files - machine generated
pnpm-lock.yaml
