{
  "name": "@promptscript/validator",
  "version": "0.0.1",
  "description": "AST validation rules for PromptScript",
  "keywords": [
    "cli",
    "enterprise",
    "typescript",
    "devtools",
    "prompt-as-code",
    "cursor",
    "developer-experience",
    "governance",
    "claude",
    "ai-tools",
    "github-copilot",
    "llm",
    "prompt-engineering",
    "promptscript",
    "antigravity",
    "promptops"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mrwogu/promptscript.git",
    "directory": "packages/validator"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.d.ts.map",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.d.ts",
  "dependencies": {
    "@swc/helpers": "~0.5.23",
    "@promptscript/core": "workspace:^"
  },
  "publishConfig": {
    "main": "./src/index.js",
    "exports": {
      ".": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
