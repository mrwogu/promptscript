---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// Raw HTML on purpose: Markdown would split the <pre> code windows on blank
// lines and turn quotes into smart quotes.
import home from '../components/home.html?raw';
import cli from '../../../../packages/cli/package.json';
import { faqJsonLd, homeJsonLd } from '../seo';
import { HOME_FAQ, faqHtml } from '../faq';
import { projectStats, statsLine } from '../stats';

const proof = statsLine(await projectStats());
const html = home
  .replace('<!-- proof -->', proof ? `<p class="home-proof-line">${proof}</p>` : '')
  .replace('<!-- faq -->', faqHtml(HOME_FAQ));
---

<StarlightPage
  frontmatter={{
    title: 'One Source for Claude, Copilot and Cursor Rules',
    description:
      'PromptScript is an open-source compiler for AI coding agent rules. Write instructions, skills, agents, and MCP servers once and get native files for 50 tools.',
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    lastUpdated: false,
    head: [
      { tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
      homeJsonLd(cli.version),
      faqJsonLd(HOME_FAQ),
      {
        tag: 'meta',
        attrs: {
          name: 'keywords',
          content:
            'PromptScript, CLAUDE.md, AGENTS.md, Cursor rules, copilot-instructions.md, AI coding agent rules, prompts as code, AI skills, MCP servers, Claude Code, GitHub Copilot, Codex, Gemini CLI, AI governance',
        },
      },
    ],
  }}
>
  <Fragment set:html={html} />
  <script>
    import { initHomeMotion } from '../scripts/home-motion';
    initHomeMotion();
  </script>
</StarlightPage>
